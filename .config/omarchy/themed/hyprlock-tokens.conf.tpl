# Rendered for every Omarchy theme (omarchy-theme-set-templates). Sourced by ~/.config/hypr/hyprlock.conf
# after the theme's hyprlock.conf so lock-screen labels follow the theme instead of hardcoded colors.
$text_color = rgba({{ foreground_rgb }}, 0.98)
$subtext_color = rgba({{ foreground_rgb }}, 0.72)
$muted_color = rgba({{ color8_rgb }}, 0.70)
$accent_color = rgba({{ accent_rgb }}, 0.95)
$accent_glow = rgba({{ accent_rgb }}, 0.22)
