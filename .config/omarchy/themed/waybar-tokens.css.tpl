/* Rendered for every Omarchy theme (omarchy-theme-set-templates). Imported by ~/.config/waybar/style.css
   so the bar follows `omarchy theme set` instead of hardcoding colors. Unique filename: stock themes
   that ship their own waybar.css can't override it. */
@define-color ink {{ foreground }};
@define-color void {{ background }};
@define-color signal {{ accent }};
@define-color alert {{ color1 }};
@define-color ash {{ color8 }};
@define-color surface {{ color0 }};
@define-color ember {{ selection_background }};
